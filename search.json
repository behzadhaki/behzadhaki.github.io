---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.category }}",
      "tags"     : "{{ post.tags | array_to_sentence_string }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date | date: '%b %-d, %Y' }}",
      "article"  : "<li class='search-result-item'><a class='search-result__link' href='{{post.url | relative_url}}'>{% if post.image %}<img class='search-result__avatar' src='{{post.image | relative_url}}' alt=''>{% endif %}<span class='search-result__text'><span class='search-result__title'>{{post.title | escape}}</span><span class='search-result__meta'>{{ post.date | date: '%b %-d, %Y' }}{% if post.description %} &mdash; {{ post.description | escape | truncate: 80 }}{% endif %}</span></span></a></li>"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
